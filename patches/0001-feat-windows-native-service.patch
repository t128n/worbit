+/// Parses `KEY=VALUE` lines (blank lines and `#` comments are ignored, a leading `export ` is
+/// accepted, and matching single or double quotes around the value are stripped).
+fn apply_environment_file(
+    path: &Path,
+    contents: &str,
+    environment: &mut BTreeMap<String, String>,
+) -> Result<(), std::io::Error> {
+    for (index, raw) in contents.lines().enumerate() {
+        let line = raw.trim().trim_start_matches('\u{feff}');
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let line = line.strip_prefix("export ").unwrap_or(line).trim_start();
+        let Some((key, value)) = line.split_once('=') else {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                format!(
+                    "environment file {}:{}: expected KEY=VALUE",
+                    path.display(),
+                    index + 1
+                ),
+            ));
+        };
+        let key = key.trim();
+        if key.is_empty() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                format!(
+                    "environment file {}:{}: empty setting name",
+                    path.display(),
+                    index + 1
+                ),
+            ));
+        }
+        environment.insert(key.to_owned(), unquote(value.trim()).to_owned());
+    }
+    Ok(())
+}
+
+fn unquote(value: &str) -> &str {
+    let bytes = value.as_bytes();
+    if bytes.len() >= 2
+        && ((bytes[0] == b'"' && bytes[bytes.len() - 1] == b'"')
+            || (bytes[0] == b'\'' && bytes[bytes.len() - 1] == b'\''))
+    {
+        &value[1..value.len() - 1]
+    } else {
+        value
+    }
+}
