diff --git a/apps/server/src/windows_service.rs b/apps/server/src/windows_service.rs
new file mode 100644
index 0000000..fb14d20
--- /dev/null
+++ b/apps/server/src/windows_service.rs
@@ -0,0 +1,411 @@
+//! Runs Orbit as a native Windows Service and manages its registration with the Service
+//! Control Manager (SCM). Compiled only on Windows (`main.rs` gates this module on
+//! `#[cfg(windows)]`), so every item here can assume a real SCM is available.
+
+use std::env;
+use std::ffi::OsString;
+use std::path::{Path, PathBuf};
+use std::process::ExitCode;
+use std::time::Duration;
+
+use orbit_platform::Config;
+use orbit_server::app::App;
+use tokio_util::sync::CancellationToken;
+use windows_service::service::{
+    ServiceAccess, ServiceControl, ServiceControlAccept, ServiceErrorControl, ServiceExitCode,
+    ServiceInfo, ServiceStartType, ServiceState, ServiceStatus, ServiceType,
+};
+use windows_service::service_control_handler::{self, ServiceControlHandlerResult};
+use windows_service::service_manager::{ServiceManager, ServiceManagerAccess};
+use windows_service::{define_windows_service, service_dispatcher};
+
+/// The SCM name used when `--name` is omitted.
+pub const DEFAULT_SERVICE_NAME: &str = "Orbit";
+const SERVICE_TYPE: ServiceType = ServiceType::OWN_PROCESS;
+/// Orbit's own main() watches for this argument to dispatch to the Service Control Manager
+/// instead of running the normal CLI. `install` registers it as the first launch argument.
+pub const RUN_ARG: &str = "__service-run";
+
+/// The launch arguments recorded for the service: `__service-run --name <name> [--env-file <path>]`.
+#[derive(Debug, Clone)]
+struct ServiceOptions {
+    name: String,
+    env_file: Option<PathBuf>,
+}
+
+impl ServiceOptions {
+    fn parse(arguments: &[OsString]) -> Self {
+        let mut options = Self {
+            name: DEFAULT_SERVICE_NAME.to_owned(),
+            env_file: None,
+        };
+        let mut index = 0;
+        while index < arguments.len() {
+            match arguments[index].to_str() {
+                Some("--name") => {
+                    if let Some(value) = arguments.get(index + 1) {
+                        options.name = value.to_string_lossy().into_owned();
+                        index += 2;
+                        continue;
+                    }
+                }
+                Some("--env-file") => {
+                    if let Some(value) = arguments.get(index + 1) {
+                        options.env_file = Some(PathBuf::from(value));
+                        index += 2;
+                        continue;
+                    }
+                }
+                _ => {}
+            }
+            index += 1;
+        }
+        options
+    }
+
+    fn launch_arguments(&self) -> Vec<OsString> {
+        let mut arguments = vec![
+            OsString::from(RUN_ARG),
+            OsString::from("--name"),
+            OsString::from(self.name.as_str()),
+        ];
+        if let Some(path) = &self.env_file {
+            arguments.push(OsString::from("--env-file"));
+            arguments.push(path.as_os_str().to_owned());
+        }
+        arguments
+    }
+}
+
+/// True for the argv the Service Control Manager uses to start Orbit
+/// (`orbit __service-run --name <name> [--env-file <path>]`).
+pub fn is_dispatch_invocation(args: &[OsString]) -> bool {
+    args.first()
+        .is_some_and(|argument| argument.to_str() == Some(RUN_ARG))
+}
+
+/// `windows_service::Error`'s `Display` omits the underlying Win32 message (for example "Access
+/// is denied") for its most common variant, which is the only part that tells an operator what
+/// to do (run as Administrator, re-run `install` with the service stopped, ...).
+fn describe(error: &windows_service::Error) -> String {
+    match std::error::Error::source(error) {
+        Some(source) => format!("{error}: {source}"),
+        None => error.to_string(),
+    }
+}
+
+fn validated_name(name: &str) -> Result<&str, String> {
+    if name.is_empty() || name.len() > 256 {
+        return Err("the service name must be between 1 and 256 characters".to_owned());
+    }
+    if name.contains('\\') || name.contains('/') {
+        return Err("the service name cannot contain a slash".to_owned());
+    }
+    Ok(name)
+}
+
+/// Registers Orbit with the Service Control Manager: automatic start, running as LocalSystem,
+/// launching this same executable with [`RUN_ARG`].
+///
+/// `env_file` is recorded in the launch arguments, so the service reads the same configuration
+/// after a reboot without machine-wide environment variables.
+pub fn install(name: &str, env_file: Option<&Path>) -> Result<String, String> {
+    let name = validated_name(name)?;
+    let manager = ServiceManager::local_computer(
+        None::<&str>,
+        ServiceManagerAccess::CONNECT | ServiceManagerAccess::CREATE_SERVICE,
+    )
+    .map_err(|error| {
+        format!(
+            "opening the Service Control Manager: {} (run this from an elevated prompt)",
+            describe(&error)
+        )
+    })?;
+    let executable_path =
+        env::current_exe().map_err(|error| format!("finding orbit.exe's own path: {error}"))?;
+    let env_file = match env_file {
+        Some(path) => {
+            let path = std::path::absolute(path)
+                .map_err(|error| format!("resolving {}: {error}", path.display()))?;
+            if !path.is_file() {
+                return Err(format!(
+                    "the environment file {} does not exist",
+                    path.display()
+                ));
+            }
+            Some(path)
+        }
+        None => None,
+    };
+    let options = ServiceOptions {
+        name: name.to_owned(),
+        env_file,
+    };
+    let service = manager
+        .create_service(
+            &ServiceInfo {
+                name: OsString::from(name),
+                display_name: OsString::from(name),
+                service_type: SERVICE_TYPE,
+                start_type: ServiceStartType::AutoStart,
+                error_control: ServiceErrorControl::Normal,
+                executable_path,
+                launch_arguments: options.launch_arguments(),
+                dependencies: vec![],
+                account_name: None,
+                account_password: None,
+            },
+            ServiceAccess::CHANGE_CONFIG,
+        )
+        .map_err(|error| format!("creating the {name} service: {}", describe(&error)))?;
+    service
+        .set_description("Orbit: a self-hosted workspace for teams.")
+        .map_err(|error| format!("setting the service description: {}", describe(&error)))?;
+    let source = match &options.env_file {
+        Some(path) => format!("environment file {}", path.display()),
+        None => "the process environment".to_owned(),
+    };
+    Ok(format!(
+        "installed the {name} service (start type: automatic, account: LocalSystem). \
+         Configuration: {source}. Start it with: Start-Service '{name}' \
+         (or: sc.exe start \"{name}\")"
+    ))
+}
+
+/// Removes Orbit's registration with the Service Control Manager. Stops the service first if
+/// it is running.
+pub fn uninstall(name: &str) -> Result<String, String> {
+    let name = validated_name(name)?;
+    let manager = ServiceManager::local_computer(None::<&str>, ServiceManagerAccess::CONNECT)
+        .map_err(|error| {
+            format!(
+                "opening the Service Control Manager: {} (run this from an elevated prompt)",
+                describe(&error)
+            )
+        })?;
+    let service = manager
+        .open_service(
+            name,
+            ServiceAccess::QUERY_STATUS | ServiceAccess::STOP | ServiceAccess::DELETE,
+        )
+        .map_err(|error| format!("opening the {name} service: {}", describe(&error)))?;
+    let status = service
+        .query_status()
+        .map_err(|error| format!("checking the {name} service status: {}", describe(&error)))?;
+    if status.current_state != ServiceState::Stopped {
+        service
+            .stop()
+            .map_err(|error| format!("stopping the {name} service: {}", describe(&error)))?;
+        // SCM reports StopPending until the process exits. Give Orbit's drain 30 seconds, the
+        // same bound the server uses for HTTP shutdown, then delete anyway.
+        for _ in 0..60 {
+            std::thread::sleep(Duration::from_millis(500));
+            let status = service.query_status().map_err(|error| {
+                format!("checking the {name} service status: {}", describe(&error))
+            })?;
+            if status.current_state == ServiceState::Stopped {
+                break;
+            }
+        }
+    }
+    service
+        .delete()
+        .map_err(|error| format!("removing the {name} service: {}", describe(&error)))?;
+    Ok(format!(
+        "removed the {name} service registration (Windows finishes removing it once the \
+         process has exited)"
+    ))
+}
+
+/// Blocks this thread for the life of the service, dispatching Service Control Manager events
+/// to [`service_main`]. Returns only once the service has stopped. An `Err` here means Orbit
+/// was not actually started by the Service Control Manager (for example, `orbit __service-run`
+/// typed directly at a prompt).
+pub fn dispatch(arguments: &[OsString]) -> ExitCode {
+    let options = ServiceOptions::parse(arguments);
+    match service_dispatcher::start(&options.name, ffi_service_main) {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!(
+                "orbit {RUN_ARG} must be started by the Windows Service Control Manager: {}. \
+                 Install the service with 'orbit service install --name {}' and start it from \
+                 Services, or run 'orbit serve' directly for a console session.",
+                describe(&error),
+                options.name
+            );
+            ExitCode::FAILURE
+        }
+    }
+}
+
+define_windows_service!(ffi_service_main, service_main);
+
+fn service_main(arguments: Vec<OsString>) {
+    let options = ServiceOptions::parse(&arguments);
+    // No console and no stdout/stderr from here on: ORBIT_LOG_FILE is the only way to see
+    // what Orbit does. A failure before tracing initializes cannot be reported anywhere.
+    let environment = match Config::environment_with_file(options.env_file.as_deref()) {
+        Ok(environment) => environment,
+        Err(error) => {
+            eprintln!("reading the Orbit environment: {error}");
+            return;
+        }
+    };
+    let format = if environment.get("ORBIT_ENV").map(String::as_str) == Some("development") {
+        orbit_platform::TracingFormat::Compact
+    } else {
+        orbit_platform::TracingFormat::Json
+    };
+    let log_file = environment
+        .get("ORBIT_LOG_FILE")
+        .map(std::path::PathBuf::from);
+    let _ = orbit_platform::init_tracing(format, log_file.as_deref());
+
+    if let Err(error) = run_service(&options.name, environment) {
+        tracing::error!(%error, "the Orbit service stopped with an error");
+    }
+}
+
+fn run_service(
+    name: &str,
+    environment: std::collections::BTreeMap<String, String>,
+) -> Result<(), String> {
+    let shutdown = CancellationToken::new();
+    let handler_shutdown = shutdown.clone();
+    let event_handler = move |control_event| match control_event {
+        ServiceControl::Interrogate => ServiceControlHandlerResult::NoError,
+        ServiceControl::Stop | ServiceControl::Shutdown => {
+            handler_shutdown.cancel();
+            ServiceControlHandlerResult::NoError
+        }
+        _ => ServiceControlHandlerResult::NotImplemented,
+    };
+    let status_handle = service_control_handler::register(name, event_handler)
+        .map_err(|error| format!("registering the service control handler: {error}"))?;
+    report_status(
+        &status_handle,
+        ServiceState::StartPending,
+        ServiceControlAccept::empty(),
+        ServiceExitCode::NO_ERROR,
+    )?;
+
+    let outcome = run_server(environment, shutdown, &status_handle);
+
+    report_status(
+        &status_handle,
+        ServiceState::Stopped,
+        ServiceControlAccept::empty(),
+        match &outcome {
+            Ok(()) => ServiceExitCode::NO_ERROR,
+            Err(_) => ServiceExitCode::Win32(1),
+        },
+    )?;
+    outcome
+}
+
+fn run_server(
+    environment: std::collections::BTreeMap<String, String>,
+    shutdown: CancellationToken,
+    status_handle: &windows_service::service_control_handler::ServiceStatusHandle,
+) -> Result<(), String> {
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .map_err(|error| format!("starting the Tokio runtime: {error}"))?;
+    let outcome = runtime.block_on(async move {
+        let config = Config::from_environment(environment)
+            .map_err(|error| format!("invalid configuration: {error}"))?;
+        config
+            .validate()
+            .map_err(|error| format!("invalid configuration: {error}"))?;
+        let app = App::build(config)
+            .await
+            .map_err(|error| format!("starting Orbit: {error}"))?;
+        if let Some(url) = app.setup_url() {
+            tracing::info!(%url, "initial setup URL");
+        }
+        report_status(
+            status_handle,
+            ServiceState::Running,
+            ServiceControlAccept::STOP,
+            ServiceExitCode::NO_ERROR,
+        )?;
+        app.run(shutdown)
+            .await
+            .map_err(|error| format!("Orbit stopped with an error: {error}"))
+    });
+    runtime.shutdown_timeout(Duration::ZERO);
+    outcome
+}
+
+fn report_status(
+    status_handle: &windows_service::service_control_handler::ServiceStatusHandle,
+    state: ServiceState,
+    controls_accepted: ServiceControlAccept,
+    exit_code: ServiceExitCode,
+) -> Result<(), String> {
+    status_handle
+        .set_service_status(ServiceStatus {
+            service_type: SERVICE_TYPE,
+            current_state: state,
+            controls_accepted,
+            exit_code,
+            checkpoint: 0,
+            wait_hint: Duration::default(),
+            process_id: None,
+        })
+        .map_err(|error| format!("reporting {state:?} to the Service Control Manager: {error}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args(values: &[&str]) -> Vec<OsString> {
+        values.iter().map(OsString::from).collect()
+    }
+
+    #[test]
+    fn dispatch_requires_the_run_argument_first() {
+        assert!(is_dispatch_invocation(&args(&[RUN_ARG])));
+        assert!(is_dispatch_invocation(&args(&[
+            RUN_ARG, "--name", "Worbit"
+        ])));
+        assert!(!is_dispatch_invocation(&args(&["serve"])));
+        assert!(!is_dispatch_invocation(&args(&["--name", RUN_ARG])));
+    }
+
+    #[test]
+    fn parses_name_and_env_file_in_any_order() {
+        let options = ServiceOptions::parse(&args(&[
+            RUN_ARG,
+            "--env-file",
+            r"C:\ProgramData\Worbit\worbit.env",
+            "--name",
+            "Worbit",
+        ]));
+        assert_eq!(options.name, "Worbit");
+        assert_eq!(
+            options.env_file.as_deref(),
+            Some(Path::new(r"C:\ProgramData\Worbit\worbit.env"))
+        );
+    }
+
+    #[test]
+    fn defaults_to_orbit_without_a_file() {
+        let options = ServiceOptions::parse(&args(&[RUN_ARG]));
+        assert_eq!(options.name, DEFAULT_SERVICE_NAME);
+        assert!(options.env_file.is_none());
+    }
+
+    #[test]
+    fn launch_arguments_round_trip() {
+        let original = ServiceOptions {
+            name: "Worbit".to_owned(),
+            env_file: Some(PathBuf::from(r"C:\ProgramData\Worbit\worbit.env")),
+        };
+        let parsed = ServiceOptions::parse(&original.launch_arguments());
+        assert_eq!(parsed.name, original.name);
+        assert_eq!(parsed.env_file, original.env_file);
+    }
+}
