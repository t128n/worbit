# worbit service configuration.
#
# This file is read by `orbit.exe` at every start. Values here replace process
# environment variables. Keep it readable only by SYSTEM and Administrators;
# install.ps1 applies that ACL.
#
# install.ps1 creates the app key (32 random bytes, base64) at
# ORBIT_APP_KEY_FILE if that file is missing, unless ORBIT_APP_KEY is set. Keep
# a copy outside this server: without it, saved secrets (SMTP password, GitHub
# App keys, import tokens) cannot be decrypted.
#
# To create it by hand on Windows PowerShell 5.1 or later:
#   $bytes = [byte[]]::new(32)
#   $rng = [Security.Cryptography.RandomNumberGenerator]::Create()
#   try { $rng.GetBytes($bytes) } finally { $rng.Dispose() }
#   New-Item -ItemType Directory -Force C:\ProgramData\Worbit\config | Out-Null
#   [System.IO.File]::WriteAllText("C:\ProgramData\Worbit\config\app.key",
#     [Convert]::ToBase64String($bytes), [System.Text.Encoding]::ASCII)

# Required: development or production. Production requires an HTTPS origin and
# at least one trusted proxy network.
ORBIT_ENV=production

# Bind to loopback and put IIS/ARR, Caddy, or another reverse proxy in front.
ORBIT_BIND=127.0.0.1
ORBIT_PORT=8080

# The exact external URL users open.
ORBIT_PUBLIC_ORIGIN=https://orbit.example.com

# The reverse proxy addresses. Never use 0.0.0.0/0 or ::/0.
ORBIT_TRUSTED_PROXIES=127.0.0.1/32

# Optional: GitHub Enterprise. Leave unset for github.com.
# GHES:  https://ghe.example.com  -> https://ghe.example.com/api/v3
# GHEC:  https://acme.ghe.com    -> https://api.acme.ghe.com
# Set this before the first GitHub App or sign-in provider is created.
# ORBIT_GITHUB_URL=https://ghe.example.com

# Use absolute paths. The SCM starts the service with C:\Windows\System32 as
# the working directory, so relative paths would land in the wrong place.
# Keep the database, attachments, and backups on separate paths, on local disk.
ORBIT_DATABASE_PATH=C:\ProgramData\Worbit\data\orbit.sqlite
ORBIT_ATTACHMENTS_PATH=C:\ProgramData\Worbit\data\attachments
ORBIT_BACKUPS_PATH=C:\ProgramData\Worbit\backups

# Required for the Windows Service (no console). Omit it when running
# `orbit.exe serve` for a console test so logs go to stdout.
ORBIT_LOG_FILE=C:\ProgramData\Worbit\logs\orbit.log

# The key for saved secrets. Use the file, not ORBIT_APP_KEY, so the key is
# not visible through the machine environment.
ORBIT_APP_KEY_FILE=C:\ProgramData\Worbit\config\app.key

# Optional: a Postgres database instead of SQLite.
# ORBIT_DATABASE_URL=postgres://orbit:password@db.internal:5432/orbit

# Optional: a private metrics listener. Never expose /metrics publicly.
# ORBIT_METRICS_LISTEN=127.0.0.1:9090
